DATABASE_URL=postgres://user:pass@localhost:5432/depot
JWT_SECRET=change-me-to-a-random-string-of-48+-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password
APP_URL=http://localhost:3000
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GOOGLE_MAPS_BROWSER_KEY=   # restrict to your domain (HTTP referrer) + Maps JavaScript API only
GOOGLE_GEOCODING_KEY=      # separate key, server-only, restrict to Geocoding API (+ server IP if static)
SMTP_URL=                  # e.g. smtps://user:pass@smtp.host:465 ; empty = reset links print to server log
SMTP_FROM=Depot Platform <no-reply@yourdomain.com>
# SOURCE_CRS_PROJ4=         # override if the X/Y columns are not WGS84 Lo19 metres (see README)
# PGSSL=1                   # set on most hosted Postgres
